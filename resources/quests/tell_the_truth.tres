[ext_resource type="Script" path="res://resources/quest_resource.gd" id="1_c60p4"]

[resource]
script = ExtResource("1_c60p4")
id = "tell_the_truth"
primary_quest = false
title = "Spill the tea"
description = "Luka wants to know whether the player knows what is happening in the village. He asks who currently has the Book of Wotlica (book_wotlica), the tool set (tool_set), and the repaired smaragd ring (smaragd_ring, not cracked_smaragd_ring). The player must correctly identify the current owner or owners of all three items. Luka checks the answers against the latest ownership_data in the world context, rather than assuming their original owners still have them. The player can be an owner too. If an item has no recorded owner, accept an answer that nobody currently has it; for the tool set, this can be phrased as nobody having picked it up yet. Ask for missing or corrected answers without revealing the correct owners first. No item transfer to Luka is required. In return, he offers what no one else can: the correct atmospheric re-entry path. He memorized it from an old emergency beacon. The pilot of the Mara IX died in the crash — and without Luka’s knowledge, any launch attempt ends in tragedy."
condition_expression = "The player has correctly identified the current owner or owners of all three items: book_wotlica AND tool_set AND smaragd_ring. Verify each answer against the latest ownership_data, where positive quantities mean ownership and an unlisted owner has zero. Accept no current owner when nobody has a positive quantity. Answers may be given across multiple messages, but all three must still match the current ownership state when completing the quest. A claim about a past or starting owner alone is insufficient."
rewards = ["give_item(correct_reentry_path, 1)"]
