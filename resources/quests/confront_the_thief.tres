[resource]
script = ExtResource("1_u8218")
id = "confront_the_thief"
primary_quest = true
title = "Confront the Thief"
description = "The player must discover both witnesses' clues and confront Miha about Radovan's missing cat. Tanja saw the cat outside the library yesterday evening. Jurij noticed wine bottles outside the library matching the ones he had given Miha. These clues are information learned in conversations, not inventory items. Use get_npc_chat_history for tanja_draguljič and jurij_vindiš to verify that each NPC actually told the player their clue. Check the NPC's own replies, not just the player's claims. If the relevant evidence is absent from a page and next_offset is not null, request the next page before deciding it is missing. Once both conversations are verified and the player confronts Miha with both clues connecting him to the disappearance, Miha confesses and returns the cat. No item hand-in is required; do not use has_item or get_item to check or take clues."
condition_expression = "Recorded dialogue with tanja_draguljič confirms she told the player she saw Radovan's cat outside the library AND recorded dialogue with jurij_vindiš confirms he told the player about wine bottles outside the library matching those he gave Miha AND the player confronts Miha using both clues as evidence about the missing cat. Verify both conversations with get_npc_chat_history before completing the quest. Accept equivalent wording. These are conversation conditions, not item requirements."
rewards = ["give_item(cat, 1)"]
