[ext_resource type="Script" path="res://resources/quest_resource.gd" id="1_tsbrs"]

[resource]
script = ExtResource("1_tsbrs")
id = "a_date_night"
primary_quest = true
title = "A date night"
description = "### Goal
Find out whether Jurij would go on a date with Tanja. In exchange, Tanja repairs the player's cracked smaragd ring.

### Starting the task
Ask the player to speak with Jurij about the date and bring back his answer and the cracked ring.

### Verify
1. Use get_npc_chat_history(\"jurij_vindiš\") to check that the player asked about the date and accurately reported Jurij's answer.
2. If the relevant exchange is missing and next_offset exists, read the next page.
3. Either acceptance or refusal qualifies; the player must report the answer truthfully.
4. Use has_item(\"cracked_smaragd_ring\", 1) to verify the ring.

### Finishing
Once the conversation and ring are verified:
1. Call get_item(\"cracked_smaragd_ring\", 1).
2. After success, grant the reward listed in Rewards.
3. After the reward succeeds, call complete_quest(\"a_date_night\").
"
condition_expression = "cracked_smaragd_ring == 1 AND the player truthfully reported Jurij's answer to the date invitation, verified in Jurij's conversation history."
rewards = ["give_item(smaragd_ring, 1)"]
